# This file names approved, non-password inputs only. Do not place client
# secrets, passwords, access tokens, refresh tokens, or cookie values here.
STAGE3_IDP_BASE_URL=https://approved-enterprise-test-origin.example
STAGE3_IDP_TENANT_REFERENCE=approved-tenant-reference
STAGE3_IDP_OIDC_ISSUER_URI=https://approved-issuer.example/approved-tenant/v2.0
STAGE3_IDP_OIDC_CLIENT_ID=approved-public-client-id
STAGE3_IDP_LOGIN_ENTRY_URI=https://approved-issuer.example/approved-tenant/authorize
STAGE3_IDP_REDIRECT_URI=https://approved-enterprise-test-origin.example/login/oauth2/code/enterprise

# The enterprise identity owner captures these two Playwright storage-state
# files out of band after real employee login and protects each file with 0600.
STAGE3_IDP_EMPLOYEE_A_STORAGE_STATE_FILE="/approved/secure/path/employee-a.storage-state.json"
STAGE3_IDP_EMPLOYEE_A_SUBJECT_SHA256="<identity-owner-supplied-64-hex-digest>"
STAGE3_IDP_EMPLOYEE_A_EXPECTED_ROLES=BUSINESS_OPERATOR,BUSINESS_REVIEWER
STAGE3_IDP_EMPLOYEE_B_STORAGE_STATE_FILE="/approved/secure/path/employee-b.storage-state.json"
STAGE3_IDP_EMPLOYEE_B_SUBJECT_SHA256="<identity-owner-supplied-64-hex-digest>"
STAGE3_IDP_EMPLOYEE_B_EXPECTED_ROLES=BUSINESS_REPORTER,BUSINESS_PUBLISHER

# A and B must be different real employees. The union of approved role codes
# must contain at least four roles.
STAGE3_IDP_INVALIDATION_TARGET=B
STAGE3_IDP_INVALIDATION_MODE=revocation
STAGE3_IDP_INVALIDATION_EXPECTED_STATUS=401
STAGE3_IDP_INVALIDATION_CONFIRMATION_FILE="/approved/non-secret/path/idp-invalidation-confirmed.json"

# Optional selectors and bounded wait.
STAGE3_IDP_PROTECTED_ROUTE="/#/我的工作/待我处理"
STAGE3_IDP_AUTHENTICATED_TEXT="我的工作"
STAGE3_IDP_INVALIDATED_BOUNDARY_HEADING="登录企业账号"
STAGE3_IDP_INVALIDATION_TIMEOUT_MS=600000
