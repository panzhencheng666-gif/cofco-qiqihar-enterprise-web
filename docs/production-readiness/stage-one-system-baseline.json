      "process": "Vite 企业业务 Web",
      "port": 63182,
      "deploymentComponent": "业务 Web 静态制品与同源网关"
    },
    {
      "id": "overview-renderer",
      "ownerRepository": "cofco-qiqihar-enterprise-frontend",
      "exposure": "numeric loopback 内部组件；直接 63200 不作为验收入口",
      "process": "Vite 总揽渲染器",
      "port": 63200,
      "deploymentComponent": "总揽监测静态制品，经 63182 /overview-monitoring 代理"
    },
    {
      "id": "business-api",
      "ownerRepository": "cofco-qiqihar-enterprise-backend",
      "exposure": "numeric loopback 内部 API；浏览器只走 63182 /api",
      "process": "Spring Boot 模块化单体",
      "port": 8090,
      "deploymentComponent": "grain-trade-enterprise-backend JAR"
    },
    {
      "id": "business-database",
      "ownerRepository": "cofco-qiqihar-enterprise-backend",
      "exposure": "仅后端连接，不是浏览器或用户入口",
      "process": "PostgreSQL/PostGIS",
      "port": 5432,
      "deploymentComponent": "Flyway 管理的业务数据库"
    }
