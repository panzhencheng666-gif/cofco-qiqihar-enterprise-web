  "statusSemantics": {
    "IMPLEMENTED": "已找到实现位置，仅表示阶段一可追踪，不代表后续功能验收通过",
    "PARTIAL": "已找到部分实现或入口，后续指定阶段仍需关闭缺口",
    "NOT_EVIDENCED": "未取得与后续门禁同义的新鲜证据"
  },
  "canonicalAcceptanceEntry": {
    "url": "http://127.0.0.1:63182/",
    "host": "127.0.0.1",
    "port": 63182,
    "path": "/",
    "ownerRepository": "cofco-qiqihar-enterprise-web",
    "status": "IMPLEMENTED"
  },
  "productionDomainAssignment": {
    "domain": "PENDING_ENTERPRISE_APPROVAL",
    "canonicalPath": "/",
    "owner": "平台部署负责人",
    "status": "NOT_EVIDENCED",
    "verificationStage": "阶段十（阿里云预生产、DNS 与 TLS）",
    "rule": "批准域名只能映射到业务 Web 根入口；不得暴露内部 API 或总揽渲染器端口"
  },
  "repositoryResponsibilities": [
    {
      "repository": "cofco-qiqihar-enterprise-backend",
      "responsibilities": [
        "模块化单体业务 API、领域边界与授权执行",
        "PostgreSQL/Flyway 迁移顺序、事务、审计与后台任务",
        "三进程本地运行监督、健康检查与唯一入口所有权"
      ]
    },
    {
      "repository": "cofco-qiqihar-enterprise-frontend",
      "responsibilities": [
        "总揽监测地图与指标渲染组件",
        "仅通过业务入口的同源 /overview-monitoring 前缀提供内容",
        "地图几何、地区钻取和样本点展示"
      ]
    },
    {
      "repository": "cofco-qiqihar-enterprise-web",
      "responsibilities": [
        "63182 唯一用户入口、企业壳层与业务导航",
        "填报、审核、供需、报告、通知与总揽嵌入工作区",
        "阶段一系统基线、追踪矩阵和三仓门禁执行器"
      ]
    }
  ],
  "runtimeComponents": [
    {
      "id": "desktop-acceptance-launcher",
      "ownerRepository": "cofco-qiqihar-enterprise-backend",
      "exposure": "只打开 63182 根入口；不读取 Desktop 下同名仓库",
      "process": "/Users/federal/Desktop/启动齐齐哈尔粮食商情系统.command -> formal runtime backend scripts/local-runtime.sh",
      "port": null,
      "deploymentComponent": "macOS 用户启动命令（由 Backend 契约脚本核验）"
