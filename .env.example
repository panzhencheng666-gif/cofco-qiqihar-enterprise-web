# Enterprise prototype web runtime defaults for local development.
#
# Keep all values optional. Empty values keep built-in localhost-safe fallback.

# Core API base for legacy runtime (kept for existing modules).
VITE_API_BASE_URL=
VITE_REALTIME_DATA_MODE=

# Optional: hard override the overview iframe URL.
VITE_OVERVIEW_MAP_URL=

# Optional: override only host used by the overview iframe.
VITE_OVERVIEW_MAP_HOST=

# Optional: override only port used by the overview iframe.
VITE_OVERVIEW_MAP_PORT=
